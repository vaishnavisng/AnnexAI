CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ==============================
# CognifyAI — backend .env.example
# Copy this to backend/.env and fill in your keys.
# ==============================

# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# Optional: override the default Gemini model (default: gemini-2.5-flash)
# Allowed values: gemini-2.5-flash, gemini-2.5-flash-lite
GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional: Speechmatics ASR (audio transcription fallback)
SPEECHMATICS_API_KEY=your_speechmatics_api_key

# Optional: Speechmatics Text-to-Speech (falls back to SPEECHMATICS_API_KEY)
SPEECHMATICS_TTS_API_KEY=your_speechmatics_tts_api_key
